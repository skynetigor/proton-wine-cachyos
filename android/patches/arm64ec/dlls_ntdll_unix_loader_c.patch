     switch(machine)
     {
     case IMAGE_FILE_MACHINE_I386:  return "/i386-windows";
-    case IMAGE_FILE_MACHINE_AMD64: return "/x86_64-windows";
+#ifdef __aarch64__
+        case IMAGE_FILE_MACHINE_AMD64: return "/aarch64-windows";
+#else
